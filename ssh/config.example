# Modèle pour ~/.ssh/config (les clés privées ne sont JAMAIS versionnées).
# Créer la clé : ssh-keygen -t ed25519 -C "<id>+<login>@users.noreply.github.com" -f ~/.ssh/id_ed25519_github_perso
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github_perso
    IdentitiesOnly yes
    AddKeysToAgent yes
    IgnoreUnknown UseKeychain
    UseKeychain yes
